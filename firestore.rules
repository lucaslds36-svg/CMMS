rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: assets
    // Fields: ID, Tag, Model, Description, Location, Plant, Manufacturer, Status, InstallDate, id
    //
    // Collection: work-orders
    // Fields: ID, AssetID, PlanID, Description, Priority, Status, AssignedTo, CreatedAt, CompletedAt, ScheduledDate, EstimatedTime, Collaborators, id
    //
    // Collection: preventive-plans
    // Fields: ID, AssetIDs, AssetLastDones, AssetNextDues, Task, Frequency, LastDone, NextDue, Type, Criticality, AssetType, Location, Plant, EstimatedTime, Collaborators, id
    //
    // Collection: users
    // Fields: uid, email, displayName, photoURL, role, createdAt
    //
    // Collection: employees
    // Fields: ID, Name, Function, Status, id
    //
    // Collection: failure-records
    // Fields: Grupo, Modelo, Dia, Mes, Ano, HoraProg, ManutMecanica, ManutEletrica, IndispMecDiaria, IndispEletDiaria, IndispMensalMec, IndispMensalElet, IndispTotal, id
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "lucas.lds36@gmail.com" && request.auth.token.email_verified == true));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validString(field, min, max) {
      return request.resource.data[field] is string && 
             request.resource.data[field].size() >= min && 
             request.resource.data[field].size() <= max;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAsset(data) {
      return hasOnlyAllowedFields(['ID', 'Tag', 'Model', 'Description', 'Location', 'Plant', 'Manufacturer', 'Status', 'InstallDate', 'id']) &&
             data.ID is string && data.ID.size() > 0 &&
             data.Tag is string && data.Tag.size() > 0 &&
             data.Model is string && data.Model.size() > 0 &&
             data.Status in ['Ativo', 'Inativo', 'Em Manutenção', 'Parado'];
    }

    function isValidWorkOrder(data) {
      return hasOnlyAllowedFields(['ID', 'AssetID', 'PlanID', 'Description', 'Priority', 'Status', 'AssignedTo', 'CreatedAt', 'CompletedAt', 'ScheduledDate', 'EstimatedTime', 'Collaborators', 'id']) &&
             data.ID is string && data.AssetID is string &&
             (data.PlanID is string || !('PlanID' in data)) &&
             data.Priority in ['Baixa', 'Média', 'Alta', 'Crítica'] &&
             data.Status in ['Em Aberto', 'Em Execução', 'Concluída', 'Cancelada'] &&
             (data.ScheduledDate is string || !('ScheduledDate' in data)) &&
             (data.EstimatedTime is number || !('EstimatedTime' in data)) &&
             (data.Collaborators is number || !('Collaborators' in data));
    }

    function isValidPreventivePlan(data) {
      return hasOnlyAllowedFields(['ID', 'AssetIDs', 'AssetLastDones', 'AssetNextDues', 'Task', 'Frequency', 'LastDone', 'NextDue', 'Type', 'Criticality', 'AssetType', 'Location', 'Plant', 'EstimatedTime', 'Collaborators', 'id']) &&
             data.ID is string && data.AssetIDs is list &&
             (data.AssetLastDones is map || !('AssetLastDones' in data)) &&
             (data.AssetNextDues is map || !('AssetNextDues' in data)) &&
             data.Type in ['Preventiva', 'Inspeção', 'Lubrificação', 'Manutenção Programada'] &&
             data.Criticality in ['Alta', 'Média', 'Baixa'] &&
             data.EstimatedTime is number && data.Collaborators is number;
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt']) &&
             data.uid is string && data.email is string &&
             data.role in ['admin', 'user'];
    }

    function isValidEmployee(data) {
      return hasOnlyAllowedFields(['ID', 'Name', 'Function', 'Status', 'id']) &&
             data.ID is string && data.Name is string &&
             data.Function in ['Mecânico', 'Eletrônico', 'Outro'] &&
             data.Status in ['Ativo', 'Férias', 'Afastado'];
    }

    function isValidFailureRecord(data) {
      return hasOnlyAllowedFields(['Grupo', 'Modelo', 'Dia', 'Mes', 'Ano', 'HoraProg', 'ManutMecanica', 'ManutEletrica', 'IndispMecDiaria', 'IndispEletDiaria', 'IndispMensalMec', 'IndispMensalElet', 'IndispTotal', 'id']) &&
             data.Grupo is string && data.Modelo is string &&
             data.Dia is string && data.Mes is string && data.Ano is string;
    }

    function isValidDatabaseEntry(data) {
      return hasOnlyAllowedFields(['uid', 'key', 'data', 'updatedAt']) &&
             data.uid is string &&
             data.key is string &&
             data.data is string &&
             data.updatedAt is timestamp;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId}/databaseEntries/{key} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidDatabaseEntry(request.resource.data);
    }

    match /globalData/{key} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidAsset(request.resource.data);
      allow delete: if isAdmin();
    }

    match /work-orders/{woId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidWorkOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    match /preventive-plans/{planId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPreventivePlan(request.resource.data);
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidEmployee(request.resource.data);
      allow delete: if isAdmin();
    }

    match /failure-records/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidFailureRecord(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      // Users can create their own profile. Role must be 'user' unless they are the bootstrap admin.
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
                      (request.resource.data.role == 'user' || request.auth.token.email == "lucas.lds36@gmail.com");
      
      // Users can update their own profile but NOT their role.
      // Admins can update any user's role.
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role) ||
                      (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && request.resource.data.role in ['admin', 'user']);
      
      allow delete: if isAdmin();
    }

    match /dashboard-indicators/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /test/connection {
      allow read: if true;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
